rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user data (profile + progress subcollection) - owner only.
    // (The project catalog is served from Website/data/projects.json,
    // generated by scan-projects.js — not stored in Firestore.)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /progress/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Roadmap progress + personal notes — owner only.
      match /roadmap/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared curriculum (roadmaps/javascript) — READ-ONLY from the app.
    // Every signed-in user may read it; nobody may write it via the app.
    // The curriculum is updated only through code and deployments (the
    // owner manages the document out-of-band via the Firebase console or
    // an admin SDK). User progress is NEVER stored here — it stays under
    // users/{uid}/roadmap.
    match /roadmaps/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
