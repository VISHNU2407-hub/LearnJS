rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user data (profile + progress subcollection) - owner only.
    // (The project catalog is served from Website/data/projects.json,
    // generated by scan-projects.js — not stored in Firestore.)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /progress/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
